# Copy this file to .env and fill in your values
# Never commit the real .env to version control

# ── Ollama settings (local LLM — no API key needed) ───────────────────────────
# Start Ollama:       ollama serve
# Pull default model: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2

# Other good options:
#   LLM_MODEL=mistral
#   LLM_MODEL=llama3.1
#   LLM_MODEL=phi3
#   LLM_MODEL=gemma2

# ── Pipeline settings ─────────────────────────────────────────────────────────
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Output directory for enriched catalogs
OUTPUT_DIR=data/output

# Deduplication cosine-similarity threshold (0.0 - 1.0)
DEDUP_SIMILARITY_THRESHOLD=0.85

# Quality score threshold below which human review is flagged
HUMAN_REVIEW_THRESHOLD=50

# Enable streaming ingestion mode (true/false)
STREAMING_MODE=false

# Mock LLM mode — set true to run without Ollama (uses rule-based stubs)
MOCK_LLM=false
